{
  "name": "@aaravpos/appointment-booking-plugin",
  "version": "5.0.9",
  "description": "A React component library built with Tailwind CSS v4 and TypeScript",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:css": "pnpm dlx @tailwindcss/cli -i src/styles.css -o dist/styles.css",
    "build:all": "pnpm run build && pnpm run build:css",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build:all",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "appointment",
    "tailwindcss",
    "typescript",
    "plugin",
    "booking"
  ],
  "author": "Aaravpos",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-signature-canvas": "1.0.7",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.28.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.11.2",
    "@tailwindcss/postcss": "4.2.4",
    "libphonenumber-js": "1.13.1",
    "lodash": "4.18.1",
    "lucide-react": "1.14.0",
    "luxon": "3.7.2",
    "postcss": "8.5.14",
    "react-hook-form": "7.75.0",
    "react-phone-number-input": "3.4.16",
    "react-redux": "9.2.0",
    "react-router-dom": "7.15.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "react-toastify": "11.1.0",
    "redux-persist": "6.0.0"
  }
}